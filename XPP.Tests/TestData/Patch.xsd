<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="PatchEntry">
    <xs:sequence>
      <xs:element name="Mod" type="PatchMod" maxOccurs="unbounded" />
      <xs:element name="Expected" type="PatchExpected" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PatchMod">
    <xs:sequence>
      <xs:element name="File" type="PatchFile" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
    <xs:attribute name="Id" type="xs:string" use="required" />
  </xs:complexType>
  <xs:complexType name="PatchFile">
    <xs:sequence>
      <xs:any processContents="skip" />
    </xs:sequence>
    <xs:attribute name="Path" type="xs:string" use="required" />
  </xs:complexType>
  <xs:complexType name="PatchExpected">
    <xs:sequence>
      <xs:any processContents="skip" />
    </xs:sequence>
    <xs:attribute name="Path" type="xs:string" use="required" />
  </xs:complexType>
  <xs:element name="TestData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Entry" type="PatchEntry" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>