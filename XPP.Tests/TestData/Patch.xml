<?xml version="1.0" encoding="UTF-8"?>
<TestData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="Patch.xsd">
  <Entry Id="copy-literal-to-attr">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="v1" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <Copy Path="Mod/A/B/@C" From="'v2'" />
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A/B">
      <B C="v2" />
    </Expected>
    <Action Type="Root">
      <Action Type="OpPatch" Target="Root/Mod/Patch">
        <Action Type="OpCopy" Target="Root/Mod/Patch/Copy">
          <Target Type="NodeSet">
            <Node Path="Root/Mod/A/B/@C" />
          </Target>
          <Source Type="String" String="v2" />
          <Action Type="Set" Target="Root/Mod/A/B/@C">
            <Source Type="String" String="v2" />
          </Action>
        </Action>
      </Action>
    </Action>
  </Entry>
  <Entry Id="merge-attr-insert">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="v1" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <Merge Path="Mod/A" From="Mod/Patch/Merge/A">
            <A>
              <B D="E" />
            </A>
          </Merge>
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A/B">
      <B C="v1" D="E" />
    </Expected>
    <Action Type="Root">
      <Action Type="OpPatch" Target="Root/Mod/Patch">
        <Action Type="OpMerge" Target="Root/Mod/Patch/Merge">
          <Target Type="NodeSet">
            <Node Path="Root/Mod/A" />
          </Target>
          <Source Type="NodeSet">
            <Node Path="Root/Mod/Patch/Merge/A" />
          </Source>
          <Action Type="Merge" Target="Root/Mod/A" Source="Root/Mod/Patch/Merge/A">
            <Action Type="Merge" Target="Root/Mod/A/B" Source="Root/Mod/Patch/Merge/A/B">
              <Action Type="Insert" Target="Root/Mod/A/B"
                Source="Root/Mod/Patch/Merge/A/B/@D" Pos="Append" />
            </Action>
          </Action>
        </Action>
      </Action>
    </Action>
  </Entry>
  <Entry Id="delete-attr">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="v1" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <Delete Path="Mod/A/B/@C" />
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A/B">
      <B />
    </Expected>
  </Entry>
  <Entry Id="copy-attr-literal-with-ifelse">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="1" />
          <B C="2" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <With Path="Mod/A/B/@C">
            <If Path=".=1">
              <Any>
                <Copy From="'a'" />
              </Any>
              <None>
                <Copy From="'b'" />
              </None>
            </If>
          </With>
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A">
      <A Path="f1.xml">
        <B C="a" />
        <B C="b" />
      </A>
    </Expected>
  </Entry>
  <Entry Id="copy-attr-expr-patchvar">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="1" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <Copy Path='Mod/A/B/@C' From='sum($patch/X/@*)'>
            <X A='2' B='3' />
          </Copy>
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A/B">
      <B C="5" />
    </Expected>
  </Entry>
  <Entry Id="setvar-value-copy-attr-var">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A>
          <B C="1" />
        </A>
      </File>
      <File Path="p1.xml">
        <Patch>
          <SetVar Name="testvar" Path="sum($patch/X/@*)">
            <X A="2" B="3" />
          </SetVar>
          <SetVar Name="testvar" Path="$testvar*2" />
          <Copy Path="Mod/A/B/@C" From="$testvar" />
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/A/B">
      <B C="10" />
    </Expected>
  </Entry>
  <Entry Id="ignore-mod-file-delete">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A />
      </File>
      <File Path="p1.xml">
        <Patch>
          <Delete Path="Mod" />
          <Delete Path="Mod/@Id" />
          <Delete Path="Mod/File" />
          <Delete Path="Mod//File/@Path" />
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/@Id">Mod1</Expected>
    <Expected Path="Root/Mod/A/@Path">f1.xml</Expected>
    <Expected Path="Root/Mod/Patch/@Path">p1.xml</Expected>
  </Entry>
  <Entry Id="ignore-mod-file-rename">
    <Mod Id="Mod1">
      <File Path="f1.xml">
        <A />
      </File>
      <File Path="p1.xml">
        <Patch>
          <Copy Path="Mod/@Id">Mod2</Copy>
          <Copy Path="Mod/A/@Path">f2.xml</Copy>
          <Copy Path="Mod/Patch/@Path">p2.xml</Copy>
        </Patch>
      </File>
    </Mod>
    <Expected Path="Root/Mod/@Id">Mod1</Expected>
    <Expected Path="Root/Mod/A/@Path">f1.xml</Expected>
    <Expected Path="Root/Mod/Patch/@Path">p1.xml</Expected>
  </Entry>
</TestData>